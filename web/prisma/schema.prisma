generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}



model Campaign {
  id               String            @id @default(cuid())
  name             String?
  status           String            @default("draft")
  tone             String?
  cta              String?
  senderName       String?           @default("The Life180 Team")
  context          String?
  businessType     String?
  locationContext  String?
  followup1Delay   Int               @default(3)
  followup2Delay   Int               @default(7)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  leads            Lead[]
  errors           LeadUploadError[]
  
  // Link to specific accounts if needed in future
  aiProviderId     String?
  smtpAccountId    String?
}

model Lead {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  firstName   String
  lastName    String
  jobTitle    String
  companyName String
  email       String

  sector      String?
  city        String?
  zipcode     String?
  country     String?
  linkedinUrl String?
  notes       String?

  status      String   @default("Cold") // Cold, Warm, Hot, Closed, NotInterested
  emailSubject String?
  emailBody    String?
  aiRationale  String?
  
  sent        Boolean  @default(false)
  opened      Boolean  @default(false)
  replied     Boolean  @default(false)
  isApproved    Boolean  @default(false)
  isPaused      Boolean  @default(false)
  
  messages      Message[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([campaignId])
  @@unique([campaignId, email])
}

model Message {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  role      String   // "USER" or "LEAD"
  content   String
  messageId String?  @unique
  createdAt DateTime @default(now())
}

model LeadUploadError {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  rowNumber  Int
  field      String
  message    String

  createdAt  DateTime @default(now())

  @@index([campaignId])
}

model Settings {
  id                   String @id @default("global")
  
  // Legacy fields (kept for backward compatibility during migration)
  gmailEmailAddress    String?
  gmailRefreshToken    String?
  geminiApiKey         String?
  groqApiKey           String?
  openaiApiKey         String?
  claudeApiKey         String?
  aiProvider           String  @default("gemini")
  smtpHost             String?
  smtpPort             Int?
  smtpUser             String?
  smtpPass             String?
  smtpFromEmail        String?
  
  maxEmailsPerHour     Int @default(50)
  followupDelayOptions String @default("1,3,5,7,10,14")

  // New multi-account relations
  accounts             Account[]
}

model Account {
  id          String   @id @default(cuid())
  settingsId  String   @default("global")
  settings    Settings @relation(fields: [settingsId], references: [id])
  
  type        String   // "SMTP", "GMAIL", "AI"
  name        String   // Friendly name for the account
  provider    String   // "gemini", "groq", "openai", "claude" or "custom"
  
  // Config stored as JSON
  config      String   // JSON string of keys, host, port, etc.
  
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

